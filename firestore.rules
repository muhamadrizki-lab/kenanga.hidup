rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Global safety net: default deny
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidUserProfile(data) {
      return data.keys().hasAll([
          'uid',
          'displayName',
          'email',
          'journalTitle',
          'reminderFrequency',
          'seededDemo',
          'createdAt',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'uid',
          'displayName',
          'email',
          'photoURL',
          'journalTitle',
          'journalSubtitle',
          'quote',
          'reminderFrequency',
          'seededDemo',
          'createdAt',
          'updatedAt'
        ])
        && data.uid is string
        && data.uid.size() >= 1
        && data.uid.size() <= 128
        && data.uid.matches('^[a-zA-Z0-9_\\-]+$')
        && data.uid == request.auth.uid
        && data.displayName is string
        && data.displayName.size() >= 1
        && data.displayName.size() <= 100
        && data.email is string
        && data.email.size() >= 3
        && data.email.size() <= 200
        && (!('photoURL' in data) || (data.photoURL is string && data.photoURL.size() <= 1000))
        && data.journalTitle is string
        && data.journalTitle.size() >= 1
        && data.journalTitle.size() <= 80
        && (!('journalSubtitle' in data) || (data.journalSubtitle is string && data.journalSubtitle.size() <= 220))
        && (!('quote' in data) || (data.quote is string && data.quote.size() <= 220))
        && data.reminderFrequency in ['daily', 'weekly', 'off']
        && data.seededDemo is bool
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidMemory(data) {
      return data.keys().hasAll([
          'id',
          'userId',
          'title',
          'story',
          'excerpt',
          'date',
          'year',
          'location',
          'category',
          'mood',
          'photos',
          'isMilestone',
          'isFavorite',
          'createdAt',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'id',
          'userId',
          'title',
          'story',
          'excerpt',
          'date',
          'year',
          'location',
          'category',
          'mood',
          'photos',
          'isMilestone',
          'isFavorite',
          'createdAt',
          'updatedAt'
        ])
        && isValidId(data.id)
        && data.userId is string
        && data.userId.size() >= 1
        && data.userId.size() <= 128
        && data.userId.matches('^[a-zA-Z0-9_\\-]+$')
        && data.userId == request.auth.uid
        && data.title is string
        && data.title.size() >= 1
        && data.title.size() <= 140
        && data.story is string
        && data.story.size() >= 1
        && data.story.size() <= 10000
        && data.excerpt is string
        && data.excerpt.size() <= 280
        && data.date is string
        && data.date.size() == 10
        && data.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && data.year is number
        && data.year >= 1900
        && data.year <= 2100
        && data.location is string
        && data.location.size() <= 160
        && data.category in ['Keluarga', 'Karier', 'Travel', 'Pendakian', 'Pencapaian', 'Lainnya']
        && data.mood in ['Bahagia', 'Bersyukur', 'Haru', 'Bangga', 'Tenang', 'Petualang']
        && data.photos is list
        && data.photos.size() <= 10
        && (data.photos.size() == 0 || (data.photos[0] is string && data.photos[0].size() <= 1000))
        && data.isMilestone is bool
        && data.isFavorite is bool
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidAlbum(data) {
      return data.keys().hasAll([
          'id',
          'userId',
          'name',
          'description',
          'categoryFilter',
          'yearFilter',
          'coverPhoto',
          'createdAt',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'id',
          'userId',
          'name',
          'description',
          'categoryFilter',
          'yearFilter',
          'coverPhoto',
          'createdAt',
          'updatedAt'
        ])
        && isValidId(data.id)
        && data.userId is string
        && data.userId.size() >= 1
        && data.userId.size() <= 128
        && data.userId.matches('^[a-zA-Z0-9_\\-]+$')
        && data.userId == request.auth.uid
        && data.name is string
        && data.name.size() >= 1
        && data.name.size() <= 80
        && data.description is string
        && data.description.size() <= 300
        && data.categoryFilter in ['Semua', 'Keluarga', 'Karier', 'Travel', 'Pendakian', 'Pencapaian', 'Lainnya']
        && data.yearFilter is number
        && (data.yearFilter == 0 || (data.yearFilter >= 1900 && data.yearFilter <= 2100))
        && data.coverPhoto is string
        && data.coverPhoto.size() <= 1000
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    match /users/{userId} {
      allow get: if isSignedIn() && isValidId(userId) && request.auth.uid == userId;
      allow list: if false;
      allow create: if isVerified()
        && isValidId(userId)
        && request.auth.uid == userId
        && isValidUserProfile(incoming())
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isVerified()
        && isValidId(userId)
        && request.auth.uid == userId
        && isValidUserProfile(incoming())
        && incoming().uid == existing().uid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          incoming().diff(existing()).affectedKeys().hasOnly(['journalTitle', 'journalSubtitle', 'quote', 'reminderFrequency', 'displayName', 'photoURL', 'updatedAt'])
          || incoming().diff(existing()).affectedKeys().hasOnly(['seededDemo', 'updatedAt'])
        );
      allow delete: if false;
    }

    match /memories/{memoryId} {
      allow get: if isSignedIn() && isValidId(memoryId) && existing().userId == request.auth.uid;
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isVerified()
        && isValidId(memoryId)
        && isValidMemory(incoming())
        && incoming().id == memoryId
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isVerified()
        && isValidId(memoryId)
        && existing().userId == request.auth.uid
        && isValidMemory(incoming())
        && incoming().id == existing().id
        && incoming().userId == existing().userId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          incoming().diff(existing()).affectedKeys().hasOnly(['title', 'story', 'excerpt', 'date', 'year', 'location', 'category', 'mood', 'photos', 'isMilestone', 'isFavorite', 'updatedAt'])
          || incoming().diff(existing()).affectedKeys().hasOnly(['isFavorite', 'updatedAt'])
          || incoming().diff(existing()).affectedKeys().hasOnly(['isMilestone', 'updatedAt'])
        );
      allow delete: if isVerified() && isValidId(memoryId) && existing().userId == request.auth.uid;
    }

    match /albums/{albumId} {
      allow get: if isSignedIn() && isValidId(albumId) && existing().userId == request.auth.uid;
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isVerified()
        && isValidId(albumId)
        && isValidAlbum(incoming())
        && incoming().id == albumId
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isVerified()
        && isValidId(albumId)
        && existing().userId == request.auth.uid
        && isValidAlbum(incoming())
        && incoming().id == existing().id
        && incoming().userId == existing().userId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['name', 'description', 'categoryFilter', 'yearFilter', 'coverPhoto', 'updatedAt']);
      allow delete: if isVerified() && isValidId(albumId) && existing().userId == request.auth.uid;
    }
  }
}
